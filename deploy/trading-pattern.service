[Unit]
Description=Trading Pattern continuous demo scanner
After=network-online.target hermes-gateway.service hermes-pattern-delivery.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes/trading
Environment=HOME=/opt/hermes/home
Environment=HERMES_HOME=/opt/hermes/home
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/hermes/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/hermes/trading-venv/bin/uvicorn server_runner:app --host 127.0.0.1 --port 8081 --timeout-graceful-shutdown 15
Restart=always
RestartSec=10
TimeoutStopSec=60
UMask=0077
MemoryHigh=180M
MemoryMax=320M
MemorySwapMax=600M
CPUQuota=60%
Nice=5

[Install]
WantedBy=multi-user.target
