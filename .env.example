# FCC Trader Workbench — environment configuration
# Copy this file to `.env` and fill in your values. The server reads .env
# automatically on startup if `python-dotenv` is installed.

# Capital.com broker credentials.
# Get an API key from https://capital.com/api-integration after enabling
# API access on your account.
CAPITAL_API_KEY=
CAPITAL_LOGIN=
CAPITAL_PASSWORD=
# This workbench is hard-locked to Capital.com's paper-trading environment.
CAPITAL_ENVIRONMENT=demo
# Optional. The MT5/accountId of the account to trade on (e.g. "1038584").
# When your login has multiple CFD accounts, this pins the primary one.
CAPITAL_ACCOUNT_ID=

# Server bind. Default: 0.0.0.0:8081
SERVER_HOST=0.0.0.0
SERVER_PORT=8081

# Local fcc-server proxy used by the AI agent orchestrator.
FCC_PROXY_URL=http://localhost:8082/v1/messages

# Optional pattern-event messages through an already configured Hermes bot.
# No bot token is copied into the workbench. Use an explicitly verified chat.
PATTERN_TELEGRAM_ENABLED=false
PATTERN_TELEGRAM_TARGET=
PATTERN_HERMES_EXECUTABLE=hermes
## Linux server: optional resident sender; configured by the staging service.
PATTERN_HERMES_SOCKET=
